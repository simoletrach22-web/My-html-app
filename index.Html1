<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>لعبة النقر سيمو</title>
<link rel="manifest" href="./manifest.json">
<meta name="theme-color" content="#FFD700">
<style>
body {margin:0; background:#0f0c29; color:white; font-family:'Arial'; text-align:center; padding-top:50px}
h1 {font-size:40px; color:#FFD700}
#score {font-size:60px; font-weight:900}
button {width:200px; height:200px; border-radius:50%; font-size:30px; background:linear-gradient(180deg, #FF416C, #FF4B2B); color:white; border:none; margin-top:30px; box-shadow:0 0 30px gold}
button:active {transform:scale(0.9)}
</style>
</head>
<body>
<h1>👑 لعبة النقر سيمو</h1>
<p>جمع الفلوس</p>
<div id="score">0</div>
<button onclick="clickMe()">💰 اضغط</button>

<script>
let score = 0;
function clickMe(){ score++; document.getElementById('score').textContent = score; }
if('serviceWorker' in navigator) { navigator.serviceWorker.register('./sw.js'); }
</script>
</body>
</html>

